# RelOS PWA - Environment Variables
# Copy this file to .env.local for local development and fill in real values.
# Never commit .env.local or any file containing real secrets.

# OpenAI API key used server-side by the /api/ai/* routes.
# Kept WITHOUT the NEXT_PUBLIC_ prefix so it is never bundled into client code.
OPENAI_API_KEY=sk-...

# When true (or when OPENAI_API_KEY is unset), the AI routes return static
# demo content instead of calling the OpenAI API. Useful for local dev/demos.
NEXT_PUBLIC_DEMO_MODE=true

# Optional: Supabase (only needed once persistent storage replaces
# the localStorage-based demo data manager in src/lib/dataManager.ts).
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
